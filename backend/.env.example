# Existing pipeline paths are owned by app/config.py
# data directory: ./data
# SQLite catalog: ./data/catalog.sqlite
# FAISS index: ./data/index/tiles.faiss
# OpenCLIP checkpoint cache: ~/.cache/clip

# Generated HTTP assets
SI_GENERATED_DIR=./data/generated

# HTTP server
CORS_ALLOWED_ORIGINS=http://localhost:5173
HOST=127.0.0.1
PORT=8000

# Frontend uses this value when served separately
VITE_API_BASE_URL=http://localhost:8000
VITE_USE_FIXTURES=false
